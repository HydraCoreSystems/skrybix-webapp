SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://localhost:3000
# Random secret used to sign the login session cookie (not the password
# itself -- that's stored hashed in the site_auth table). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Bearer token required by GM Commerce to read selected cutting records.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COMMERCE_EXPORT_KEY=
